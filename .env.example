# SubTube — نمونه متغیرها و سکرت‌ها (همه مقادیر ساختگی‌اند)
# در Cloudflare این‌ها از بخش Settings → Variables and Secrets یا با
# دستور «wrangler secret put NAME» تنظیم می‌شوند، نه با فایل .env واقعی.
# راهنمای کامل: docs/CONFIG_FA.md

# ===== سکرت‌ها (اجباری) =====
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET

# ===== سکرت‌ها (بسته به مسیرهایی که می‌خواهید فعال باشند) =====
SUPADATA_API_KEY=YOUR_SUPADATA_API_KEY
COARENA_API_KEY=YOUR_COARENA_API_KEY
COARENA_API_KEY_2=YOUR_SECOND_COARENA_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DIAG_TOKEN=YOUR_DIAG_TOKEN

# ===== متغیرهای ساده (اختیاری — پیش‌فرض داخل کد هست) =====
MAX_CUE_COUNT=1200
MAX_TOTAL_CHARS=45000
RATE_LIMIT_MAX_PER_HOUR=10
TRANSLATION_PROVIDER=coarena
TRANSLATION_MODEL=gemini-4-argon
